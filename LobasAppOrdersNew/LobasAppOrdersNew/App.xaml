<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LobasAppOrdersNew.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="AppBackgroundColor">#FFF1F2</Color>
            <Color x:Key="AppPrimaryColor">#DB2777</Color>
            <Color x:Key="AppSecondaryColor">#BE185D</Color>
            <Color x:Key="AppTextColor">#831843</Color>
            <Color x:Key="AppCardColor">#FFFFFF</Color>
            <Color x:Key="AppBorderColor">#FBCFE8</Color>
            <Color x:Key="AppMutedTextColor">#6B7280</Color>
            <Color x:Key="AppButtonTextColor">#FFFFFF</Color>
            <Color x:Key="AppInputBackgroundColor">#FFFFFF</Color>
            <Color x:Key="AppPlaceholderColor">#C08497</Color>
            <Color x:Key="AppDangerColor">#DC2626</Color>
            <Color x:Key="AppEditColor">#6366F1</Color>
            <Color x:Key="AppShellHeaderColor">#831843</Color>
            <Color x:Key="AppShellHeaderTextColor">#FFFFFF</Color>
            <Color x:Key="AppShellHeaderMutedTextColor">#FCE7F3</Color>

            <x:String x:Key="AppBodyFontFamily">OpenSansRegular</x:String>
            <x:String x:Key="AppTitleFontFamily">OpenSansSemibold</x:String>
            <x:String x:Key="AppButtonFontFamily">OpenSansSemibold</x:String>
            <x:Double x:Key="AppTitleFontSize">30</x:Double>
            <x:Double x:Key="AppSubtitleFontSize">14</x:Double>
            <x:Double x:Key="AppBodyFontSize">15</x:Double>
            <x:Double x:Key="AppCaptionFontSize">13</x:Double>

            <Style x:Key="PageTitleStyle" TargetType="Label">
                <Setter Property="FontSize" Value="{DynamicResource AppTitleFontSize}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontFamily" Value="{DynamicResource AppTitleFontFamily}" />
                <Setter Property="TextColor" Value="{DynamicResource AppTextColor}" />
            </Style>

            <Style x:Key="PageSubtitleStyle" TargetType="Label">
                <Setter Property="FontSize" Value="{DynamicResource AppSubtitleFontSize}" />
                <Setter Property="FontFamily" Value="{DynamicResource AppBodyFontFamily}" />
                <Setter Property="TextColor" Value="{DynamicResource AppSecondaryColor}" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="Label">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontFamily" Value="{DynamicResource AppTitleFontFamily}" />
                <Setter Property="TextColor" Value="{DynamicResource AppTextColor}" />
            </Style>

            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{DynamicResource AppPrimaryColor}" />
                <Setter Property="TextColor" Value="{DynamicResource AppButtonTextColor}" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontFamily" Value="{DynamicResource AppButtonFontFamily}" />
                <Setter Property="HeightRequest" Value="50" />
            </Style>

            <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{DynamicResource AppPrimaryColor}" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontFamily" Value="{DynamicResource AppButtonFontFamily}" />
                <Setter Property="HeightRequest" Value="50" />
            </Style>

            <Style x:Key="CardFrameStyle" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="{DynamicResource AppCardColor}" />
                <Setter Property="BorderColor" Value="{DynamicResource AppBorderColor}" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="HasShadow" Value="True" />
            </Style>

            <Style x:Key="InputEntryStyle" TargetType="Entry">
                <Setter Property="BackgroundColor" Value="{DynamicResource AppInputBackgroundColor}" />
                <Setter Property="TextColor" Value="{DynamicResource AppTextColor}" />
                <Setter Property="PlaceholderColor" Value="{DynamicResource AppPlaceholderColor}" />
                <Setter Property="FontFamily" Value="{DynamicResource AppBodyFontFamily}" />
                <Setter Property="FontSize" Value="{DynamicResource AppBodyFontSize}" />
                <Setter Property="HeightRequest" Value="50" />
            </Style>

            <Style x:Key="InputEditorStyle" TargetType="Editor">
                <Setter Property="BackgroundColor" Value="{DynamicResource AppInputBackgroundColor}" />
                <Setter Property="TextColor" Value="{DynamicResource AppTextColor}" />
                <Setter Property="PlaceholderColor" Value="{DynamicResource AppPlaceholderColor}" />
                <Setter Property="FontFamily" Value="{DynamicResource AppBodyFontFamily}" />
                <Setter Property="FontSize" Value="{DynamicResource AppBodyFontSize}" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
