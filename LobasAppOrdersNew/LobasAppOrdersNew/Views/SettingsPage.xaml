<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LobasAppOrdersNew.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Ajustes"
    BackgroundColor="{DynamicResource AppBackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="22">

            <VerticalStackLayout Spacing="4">
                <Label
                    Text="Ajustes"
                    Style="{StaticResource PageTitleStyle}" />

                <Label
                    Text="Personaliza los colores y la tipografía de la aplicación"
                    Style="{StaticResource PageSubtitleStyle}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="16">

                    <Label
                        Text="Estilo visual"
                        Style="{StaticResource SectionTitleStyle}" />

                    <Label
                        Text="El estilo elegido se guarda en este dispositivo y se aplica al iniciar la app."
                        FontSize="{DynamicResource AppBodyFontSize}"
                        TextColor="{DynamicResource AppMutedTextColor}" />

                    <Button
                        Text="Lobas claro"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Clicked="OnPinkThemeClicked" />

                    <Button
                        Text="Nocturno profesional"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Clicked="OnDarkThemeClicked" />

                    <Label
                        x:Name="CurrentThemeLabel"
                        FontSize="{DynamicResource AppCaptionFontSize}"
                        TextColor="{DynamicResource AppMutedTextColor}" />

                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="Vista previa"
                        Style="{StaticResource SectionTitleStyle}" />

                    <Label
                        Text="Texto principal"
                        FontSize="{DynamicResource AppBodyFontSize}"
                        FontFamily="{DynamicResource AppBodyFontFamily}"
                        TextColor="{DynamicResource AppTextColor}" />

                    <Label
                        Text="Texto secundario y de apoyo"
                        FontSize="{DynamicResource AppCaptionFontSize}"
                        FontFamily="{DynamicResource AppBodyFontFamily}"
                        TextColor="{DynamicResource AppMutedTextColor}" />

                    <Entry
                        Placeholder="Campo de ejemplo"
                        Style="{StaticResource InputEntryStyle}" />

                    <Button
                        Text="Botón de ejemplo"
                        Style="{StaticResource PrimaryButtonStyle}" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
