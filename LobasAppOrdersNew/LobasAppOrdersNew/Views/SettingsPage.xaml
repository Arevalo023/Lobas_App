<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LobasAppOrdersNew.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Ajustes"
    BackgroundColor="{DynamicResource AppBackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="22">

            <VerticalStackLayout Spacing="4">
                <Label
                    Text="Ajustes"
                    Style="{StaticResource PageTitleStyle}" />

                <Label
                    Text="Personaliza el estilo visual de la aplicación"
                    Style="{StaticResource PageSubtitleStyle}" />
            </VerticalStackLayout>

            <Frame Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="16">

                    <Label
                        Text="Tema de la aplicación"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource AppTextColor}" />

                    <Label
                        Text="Puedes cambiar entre dos estilos de color y texto."
                        FontSize="{DynamicResource AppBodyFontSize}"
                        TextColor="{DynamicResource AppMutedTextColor}" />

                    <Button
                        Text="Usar tema rosa"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Clicked="OnPinkThemeClicked" />

                    <Button
                        Text="Usar tema oscuro"
                        BackgroundColor="#111827"
                        TextColor="White"
                        CornerRadius="18"
                        HeightRequest="50"
                        FontAttributes="Bold"
                        Clicked="OnDarkThemeClicked" />

                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Vista previa"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource AppTextColor}" />

                    <Label
                        Text="Este texto cambia según el tema seleccionado."
                        FontSize="{DynamicResource AppBodyFontSize}"
                        TextColor="{DynamicResource AppMutedTextColor}" />

                    <Button
                        Text="Botón de ejemplo"
                        Style="{StaticResource PrimaryButtonStyle}" />

                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>