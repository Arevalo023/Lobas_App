<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LobasAppOrdersNew.Views.ProductsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:LobasAppOrdersNew.Models"
    xmlns:viewModels="clr-namespace:LobasAppOrdersNew.ViewModels"
    x:DataType="viewModels:ProductsViewModel"
    Title="Productos"
    BackgroundColor="{DynamicResource AppBackgroundColor}">

    <Grid
        RowDefinitions="Auto,Auto,*"
        Padding="20"
        RowSpacing="16">

        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label
                Text="Productos"
                Style="{StaticResource PageTitleStyle}" />

            <Label
                Text="Administra el catálogo de productos"
                Style="{StaticResource PageSubtitleStyle}" />
        </VerticalStackLayout>

        <Grid
            Grid.Row="1"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="10">

            <SearchBar
                Grid.Column="0"
                Placeholder="Buscar producto..."
                Text="{Binding SearchText}"
                BackgroundColor="{DynamicResource AppInputBackgroundColor}"
                TextColor="{DynamicResource AppTextColor}"
                PlaceholderColor="{DynamicResource AppPlaceholderColor}" />

            <Button
    Grid.Column="1"
    Text="+"
    FontSize="24"
    FontAttributes="Bold"
    Style="{StaticResource PrimaryButtonStyle}"
    WidthRequest="55"
    HeightRequest="55"
    Clicked="OnAddProductClicked" />
        </Grid>

        <RefreshView
            Grid.Row="2"
            Command="{Binding RefreshCommand}"
            IsRefreshing="{Binding IsRefreshing}">

            <CollectionView
                ItemsSource="{Binding Products}"
                SelectionMode="None">

                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Spacing="10">

                        <Label
                            Text="No hay productos para mostrar."
                            TextColor="{DynamicResource AppTextColor}"
                            FontSize="16"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="Revisa que tu API local esté corriendo."
                            TextColor="{DynamicResource AppMutedTextColor}"
                            FontSize="13"
                            HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ProductModel">
                        <SwipeView Margin="0,0,0,12">

                            <SwipeView.LeftItems>
                                <SwipeItems Mode="Reveal">
                                    <SwipeItem
                    Text="Editar"
                    BackgroundColor="{DynamicResource AppEditColor}"
                    Invoked="OnEditProductInvoked" />
                                </SwipeItems>
                            </SwipeView.LeftItems>

                            <SwipeView.RightItems>
                                <SwipeItems Mode="Reveal">
                                    <SwipeItem
                    Text="Eliminar"
                    BackgroundColor="{DynamicResource AppDangerColor}"
                    Invoked="OnDeleteProductInvoked" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Border Style="{StaticResource CardFrameStyle}">

                                <Grid
                ColumnDefinitions="*,Auto"
                RowDefinitions="Auto,Auto,Auto"
                ColumnSpacing="10">

                                    <Label
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="{Binding Name}"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="{DynamicResource AppTextColor}" />

                                    <Label
                    Grid.Row="0"
                    Grid.Column="1"
                    Text="{Binding PriceText}"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="{DynamicResource AppPrimaryColor}" />

                                    <Label
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Text="{Binding Description}"
                    FontSize="13"
                    TextColor="{DynamicResource AppMutedTextColor}"
                    Margin="0,4,0,0" />

                                    <Label
                    Grid.Row="2"
                    Grid.Column="0"
                    Text="{Binding StockText}"
                    FontSize="13"
                    TextColor="{DynamicResource AppSecondaryColor}"
                    Margin="0,8,0,0" />

                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </RefreshView>

    </Grid>
</ContentPage>
