<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LobasAppOrdersNew.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Acerca de"
    BackgroundColor="{DynamicResource AppBackgroundColor}">

    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="18">

            <Frame
                Style="{StaticResource CardFrameStyle}"
                MaximumWidthRequest="760"
                HorizontalOptions="Center">

                <VerticalStackLayout Spacing="18">

                    <Image
                        Source="splash.png"
                        WidthRequest="120"
                        HeightRequest="120"
                        Aspect="AspectFit"
                        HorizontalOptions="Center" />

                    <VerticalStackLayout Spacing="4">
                        <Label
                            Text="Lobas Orders"
                            Style="{StaticResource PageTitleStyle}"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="Order Management App"
                            Style="{StaticResource PageSubtitleStyle}"
                            HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <BoxView
                        HeightRequest="1"
                        Color="{DynamicResource AppBorderColor}" />

                    <Label
                        Text="Descripción"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource AppTextColor}" />

                    <Label
                        Text="Lobas Orders es una aplicación multiplataforma desarrollada en .NET MAUI para administrar clientes, productos y pedidos. Permite registrar información, consultar listados, buscar registros, crear pedidos con productos, calcular totales y mantener control del inventario."
                        FontSize="{DynamicResource AppBodyFontSize}"
                        TextColor="{DynamicResource AppMutedTextColor}"
                        LineBreakMode="WordWrap" />

                    <Label
                        Text="Características principales"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource AppTextColor}" />

                    <VerticalStackLayout Spacing="10">

                        <Frame
                            Style="{StaticResource CardFrameStyle}"
                            HasShadow="False">
                            <Label
                                Text="✓ Inicio de sesión con correo y contraseña"
                                TextColor="{DynamicResource AppTextColor}"
                                FontSize="{DynamicResource AppBodyFontSize}" />
                        </Frame>

                        <Frame
                            Style="{StaticResource CardFrameStyle}"
                            HasShadow="False">
                            <Label
                                Text="✓ Inicio de sesión con Google"
                                TextColor="{DynamicResource AppTextColor}"
                                FontSize="{DynamicResource AppBodyFontSize}" />
                        </Frame>

                        <Frame
                            Style="{StaticResource CardFrameStyle}"
                            HasShadow="False">
                            <Label
                                Text="✓ Acceso mediante autenticación biométrica"
                                TextColor="{DynamicResource AppTextColor}"
                                FontSize="{DynamicResource AppBodyFontSize}" />
                        </Frame>

                        <Frame
                            Style="{StaticResource CardFrameStyle}"
                            HasShadow="False">
                            <Label
                                Text="✓ CRUD de productos, clientes y pedidos"
                                TextColor="{DynamicResource AppTextColor}"
                                FontSize="{DynamicResource AppBodyFontSize}" />
                        </Frame>

                        <Frame
                            Style="{StaticResource CardFrameStyle}"
                            HasShadow="False">
                            <Label
                                Text="✓ Búsqueda en listados y navegación con menú lateral"
                                TextColor="{DynamicResource AppTextColor}"
                                FontSize="{DynamicResource AppBodyFontSize}" />
                        </Frame>

                        <Frame
                            Style="{StaticResource CardFrameStyle}"
                            HasShadow="False">
                            <Label
                                Text="✓ Cambio dinámico de tema visual"
                                TextColor="{DynamicResource AppTextColor}"
                                FontSize="{DynamicResource AppBodyFontSize}" />
                        </Frame>

                    </VerticalStackLayout>

                    <Label
                        Text="Tecnologías utilizadas"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource AppTextColor}" />

                    <Grid
                        ColumnDefinitions="*,*"
                        RowDefinitions="Auto,Auto,Auto"
                        ColumnSpacing="12"
                        RowSpacing="12">

                        <Frame
                            Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource CardFrameStyle}"
                            HasShadow="False">
                            <VerticalStackLayout>
                                <Label
                                    Text=".NET MAUI"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource AppPrimaryColor}" />
                                <Label
                                    Text="Frontend multiplataforma"
                                    TextColor="{DynamicResource AppMutedTextColor}"
                                    FontSize="13" />
                            </VerticalStackLayout>
                        </Frame>

                        <Frame
                            Grid.Row="0"
                            Grid.Column="1"
                            Style="{StaticResource CardFrameStyle}"
                            HasShadow="False">
                            <VerticalStackLayout>
                                <Label
                                    Text="ASP.NET Core API"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource AppPrimaryColor}" />
                                <Label
                                    Text="Backend REST"
                                    TextColor="{DynamicResource AppMutedTextColor}"
                                    FontSize="13" />
                            </VerticalStackLayout>
                        </Frame>

                        <Frame
                            Grid.Row="1"
                            Grid.Column="0"
                            Style="{StaticResource CardFrameStyle}"
                            HasShadow="False">
                            <VerticalStackLayout>
                                <Label
                                    Text="SQL Server"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource AppPrimaryColor}" />
                                <Label
                                    Text="Base de datos"
                                    TextColor="{DynamicResource AppMutedTextColor}"
                                    FontSize="13" />
                            </VerticalStackLayout>
                        </Frame>

                        <Frame
                            Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource CardFrameStyle}"
                            HasShadow="False">
                            <VerticalStackLayout>
                                <Label
                                    Text="MVVM"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource AppPrimaryColor}" />
                                <Label
                                    Text="Patrón de arquitectura"
                                    TextColor="{DynamicResource AppMutedTextColor}"
                                    FontSize="13" />
                            </VerticalStackLayout>
                        </Frame>

                        <Frame
                            Grid.Row="2"
                            Grid.Column="0"
                            Style="{StaticResource CardFrameStyle}"
                            HasShadow="False">
                            <VerticalStackLayout>
                                <Label
                                    Text="Google Auth"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource AppPrimaryColor}" />
                                <Label
                                    Text="Login con red social"
                                    TextColor="{DynamicResource AppMutedTextColor}"
                                    FontSize="13" />
                            </VerticalStackLayout>
                        </Frame>

                        <Frame
                            Grid.Row="2"
                            Grid.Column="1"
                            Style="{StaticResource CardFrameStyle}"
                            HasShadow="False">
                            <VerticalStackLayout>
                                <Label
                                    Text="Biometric Auth"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource AppPrimaryColor}" />
                                <Label
                                    Text="Huella digital"
                                    TextColor="{DynamicResource AppMutedTextColor}"
                                    FontSize="13" />
                            </VerticalStackLayout>
                        </Frame>

                    </Grid>

                    <Label
                        Text="Información del proyecto"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource AppTextColor}" />

                    <Frame
                        Style="{StaticResource CardFrameStyle}"
                        HasShadow="False">
                        <VerticalStackLayout Spacing="8">

                            <Label
                                Text="Proyecto final de aplicación multiplataforma"
                                TextColor="{DynamicResource AppTextColor}"
                                FontAttributes="Bold"
                                FontSize="{DynamicResource AppBodyFontSize}" />

                            <Label
                                Text="Versión: 1.0"
                                TextColor="{DynamicResource AppMutedTextColor}"
                                FontSize="13" />

                            <Label
                                Text="Plataformas: Windows y Android"
                                TextColor="{DynamicResource AppMutedTextColor}"
                                FontSize="13" />

                            <Label
                                Text="Desarrollado con arquitectura MVVM y consumo de API REST."
                                TextColor="{DynamicResource AppMutedTextColor}"
                                FontSize="13" />

                        </VerticalStackLayout>
                    </Frame>

                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>