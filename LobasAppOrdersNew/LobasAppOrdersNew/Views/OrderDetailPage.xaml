<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LobasAppOrdersNew.Views.OrderDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Detalle del pedido"
    BackgroundColor="{DynamicResource AppBackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <Frame Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="{Binding OrderNumberText}"
                        Style="{StaticResource PageTitleStyle}" />

                    <Label
                        Text="{Binding CustomerName}"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource AppSecondaryColor}" />

                    <Label
                        Text="{Binding DateText}"
                        FontSize="{DynamicResource AppBodyFontSize}"
                        TextColor="{DynamicResource AppMutedTextColor}" />

                    <Label
                        Text="{Binding StatusText}"
                        FontSize="{DynamicResource AppBodyFontSize}"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource AppPrimaryColor}" />

                    <BoxView
                        HeightRequest="1"
                        Color="{DynamicResource AppBorderColor}"
                        Margin="0,10,0,6" />

                    <Label
                        Text="{Binding TotalText}"
                        FontSize="26"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource AppPrimaryColor}"
                        HorizontalTextAlignment="End" />

                </VerticalStackLayout>
            </Frame>

            <Label
                Text="Productos del pedido"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="{DynamicResource AppTextColor}" />

            <CollectionView
                ItemsSource="{Binding Details}"
                SelectionMode="None">

                <CollectionView.EmptyView>
                    <Label
                        Text="Este pedido no tiene productos."
                        TextColor="{DynamicResource AppMutedTextColor}"
                        HorizontalTextAlignment="Center" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame
                            Style="{StaticResource CardFrameStyle}"
                            Margin="0,0,0,12"
                            HasShadow="False">

                            <Grid
                                RowDefinitions="Auto,Auto,Auto"
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="10">

                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Text="{Binding ProductName}"
                                    FontSize="17"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource AppTextColor}" />

                                <Label
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text="{Binding SubtotalText}"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource AppPrimaryColor}" />

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Text="{Binding Quantity, StringFormat='Cantidad: {0}'}"
                                    FontSize="13"
                                    TextColor="{DynamicResource AppMutedTextColor}"
                                    Margin="0,6,0,0" />

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="{Binding UnitPrice, StringFormat='Precio: ${0:N2}'}"
                                    FontSize="13"
                                    TextColor="{DynamicResource AppMutedTextColor}"
                                    Margin="0,6,0,0" />

                                <Label
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Text="{Binding ProductId, StringFormat='Product ID: {0}'}"
                                    FontSize="12"
                                    TextColor="{DynamicResource AppSecondaryColor}"
                                    Margin="0,8,0,0" />

                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>