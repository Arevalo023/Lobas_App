<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LobasAppOrdersNew.Views.ProductFormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:LobasAppOrdersNew.ViewModels"
    x:DataType="viewModels:ProductFormViewModel"
    Title="Agregar producto"
    BackgroundColor="{DynamicResource AppBackgroundColor}">

    <ScrollView>
        <Grid Padding="24">

            <Border
                Style="{StaticResource CardFrameStyle}"
                MaximumWidthRequest="520"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                <VerticalStackLayout Spacing="18">

                    <VerticalStackLayout Spacing="4">
                        <Label
    Text="{Binding PageHeader}"
    Style="{StaticResource PageTitleStyle}" />

                        <Label
    Text="{Binding PageSubtitle}"
    Style="{StaticResource PageSubtitleStyle}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label
                            Text="Nombre"
                            TextColor="{DynamicResource AppTextColor}"
                            FontAttributes="Bold" />

                        <Entry
                            Placeholder="Ej. Collar para mascota"
                            Text="{Binding Name}"
                            Style="{StaticResource InputEntryStyle}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label
                            Text="Descripción"
                            TextColor="{DynamicResource AppTextColor}"
                            FontAttributes="Bold" />

                        <Editor
                            Placeholder="Descripción del producto"
                            Text="{Binding Description}"
                            Style="{StaticResource InputEditorStyle}"
                            AutoSize="TextChanges"
                            HeightRequest="90" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label
                                Text="Precio"
                                TextColor="{DynamicResource AppTextColor}"
                                FontAttributes="Bold" />

                            <Entry
                                Placeholder="0.00"
                                Text="{Binding Price}"
                                Keyboard="Numeric"
                                Style="{StaticResource InputEntryStyle}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label
                                Text="Stock"
                                TextColor="{DynamicResource AppTextColor}"
                                FontAttributes="Bold" />

                            <Entry
                                Placeholder="0"
                                Text="{Binding Stock}"
                                Keyboard="Numeric"
                                Style="{StaticResource InputEntryStyle}" />
                        </VerticalStackLayout>

                    </Grid>

                    <Grid HeightRequest="52">
                        <Button
    Text="{Binding SaveButtonText}"
    Command="{Binding SaveProductCommand}"
    Style="{StaticResource PrimaryButtonStyle}"
    HeightRequest="52" />

                        <ActivityIndicator
                            IsRunning="{Binding IsSaving}"
                            IsVisible="{Binding IsSaving}"
                            Color="{DynamicResource AppButtonTextColor}"
                            WidthRequest="24"
                            HeightRequest="24"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            Margin="0,0,18,0" />
                    </Grid>

                    <Button
                        Text="Cancelar"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" />

                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
