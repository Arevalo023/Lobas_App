<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LobasAppOrdersNew.Views.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Register"
    BackgroundColor="{DynamicResource AppBackgroundColor}">

    <ScrollView>
        <VerticalStackLayout
            Padding="{OnIdiom Phone='16,18', Tablet='28', Desktop='32'}"
            Spacing="{OnIdiom Phone=14, Tablet=20, Desktop=20}"
            VerticalOptions="Start"
            HorizontalOptions="Center"
            MaximumWidthRequest="460">

            <Label
                Text="Create Account"
                Style="{StaticResource PageTitleStyle}"
                FontSize="{OnIdiom Phone=24, Tablet={DynamicResource AppTitleFontSize}, Desktop={DynamicResource AppTitleFontSize}}"
                HorizontalOptions="Center" />

            <Label
                Text="Join Lobas Orders"
                Style="{StaticResource PageSubtitleStyle}"
                HorizontalOptions="Center" />

            <Frame
                Style="{StaticResource CardFrameStyle}"
                Padding="{OnIdiom Phone='18', Tablet='22', Desktop='22'}"
                CornerRadius="24">

                <VerticalStackLayout Spacing="16">

                    <Entry
                        Placeholder="Full name"
                        Text="{Binding Name}"
                        Style="{StaticResource InputEntryStyle}"
                        ClearButtonVisibility="WhileEditing" />

                    <Entry
                        Placeholder="Email"
                        Keyboard="Email"
                        Text="{Binding Email}"
                        Style="{StaticResource InputEntryStyle}"
                        ClearButtonVisibility="WhileEditing" />

                    <Entry
                        Placeholder="Password"
                        IsPassword="True"
                        Text="{Binding Password}"
                        Style="{StaticResource InputEntryStyle}" />

                    <Entry
                        Placeholder="Confirm password"
                        IsPassword="True"
                        Text="{Binding ConfirmPassword}"
                        Style="{StaticResource InputEntryStyle}" />

                    <Button
                        Text="Create account"
                        Command="{Binding RegisterCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" />

                    <Button
                        Text="Already have an account? Login"
                        Command="{Binding GoToLoginCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" />

                </VerticalStackLayout>
            </Frame>

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
