<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LobasAppOrdersNew.Views.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:LobasAppOrdersNew.ViewModels"
    x:DataType="viewModels:RegisterViewModel"
    Title="Register"
    BackgroundColor="{DynamicResource AppBackgroundColor}">

    <ScrollView>
        <Grid
            Padding="{OnIdiom Phone='16,18', Tablet='28', Desktop='32'}"
            RowDefinitions="Auto">

            <Border
                Style="{StaticResource CardFrameStyle}"
                MaximumWidthRequest="460"
                HorizontalOptions="Center"
                VerticalOptions="Start"
                Margin="0,12"
                Padding="{OnIdiom Phone='18', Tablet='24', Desktop='26'}">

                <VerticalStackLayout
                    Spacing="{OnIdiom Phone=12, Tablet=16, Desktop=16}">

                    <Image
                        Source="splash.png"
                        HeightRequest="{OnIdiom Phone=78, Tablet=104, Desktop=110}"
                        WidthRequest="{OnIdiom Phone=78, Tablet=104, Desktop=110}"
                        HorizontalOptions="Center"
                        Aspect="AspectFit" />

                    <Label
                        Text="Create account"
                        Style="{StaticResource PageTitleStyle}"
                        FontSize="{OnIdiom Phone=24, Tablet={DynamicResource AppTitleFontSize}, Desktop={DynamicResource AppTitleFontSize}}"
                        HorizontalTextAlignment="Center"
                        Margin="0,2,0,0" />

                    <Label
                        Text="Crea tu perfil y empieza a administrar clientes, productos y pedidos."
                        Style="{StaticResource PageSubtitleStyle}"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        Margin="0,0,0,4" />

                    <VerticalStackLayout Spacing="6">
                        <Label
                            Text="Nombre completo"
                            TextColor="{DynamicResource AppTextColor}"
                            FontAttributes="Bold" />

                        <Entry
                            Placeholder="Ingresa tu nombre completo"
                            Text="{Binding Name}"
                            Style="{StaticResource InputEntryStyle}"
                            ClearButtonVisibility="WhileEditing" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label
                            Text="Email"
                            TextColor="{DynamicResource AppTextColor}"
                            FontAttributes="Bold" />

                        <Entry
                            Placeholder="Ingresa tu email"
                            Keyboard="Email"
                            Text="{Binding Email}"
                            Style="{StaticResource InputEntryStyle}"
                            ClearButtonVisibility="WhileEditing" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label
                            Text="Contrseña"
                            TextColor="{DynamicResource AppTextColor}"
                            FontAttributes="Bold" />

                        <Entry
                            Placeholder="Crea una contraseña"
                            IsPassword="True"
                            Text="{Binding Password}"
                            Style="{StaticResource InputEntryStyle}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label
                            Text="Confirma tu contraseña"
                            TextColor="{DynamicResource AppTextColor}"
                            FontAttributes="Bold" />

                        <Entry
                            Placeholder="Repite tu contraseña"
                            IsPassword="True"
                            Text="{Binding ConfirmPassword}"
                            Style="{StaticResource InputEntryStyle}" />
                    </VerticalStackLayout>

                    <Grid HeightRequest="52">
                        <Button
                            Text="Crea una cuenta"
                            Command="{Binding RegisterCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HeightRequest="52" />

                        <ActivityIndicator
                            IsRunning="{Binding IsBusy}"
                            IsVisible="{Binding IsBusy}"
                            Color="{DynamicResource AppButtonTextColor}"
                            WidthRequest="24"
                            HeightRequest="24"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            Margin="0,0,18,0" />
                    </Grid>

                    <HorizontalStackLayout
                        HorizontalOptions="Center"
                        Spacing="4"
                        Margin="0,2,0,0">

                        <Label
                            Text="Ya tienes una cuenta?"
                            TextColor="{DynamicResource AppMutedTextColor}"
                            VerticalOptions="Center" />

                        <Button
                            Text="Login"
                            Command="{Binding GoToLoginCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="6,0"
                            MinimumWidthRequest="0" />
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
