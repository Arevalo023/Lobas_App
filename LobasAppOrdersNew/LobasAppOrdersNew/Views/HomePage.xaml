<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LobasAppOrdersNew.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:LobasAppOrdersNew.ViewModels"
    x:DataType="viewModels:HomeViewModel"
    Title="Home"
    BackgroundColor="{DynamicResource AppBackgroundColor}">

    <VerticalStackLayout
        Padding="30"
        Spacing="20"
        VerticalOptions="Center">

        <Label
            Text="Lobas Orders"
            Style="{StaticResource PageTitleStyle}"
            HorizontalOptions="Center" />

        <Label
            Text="{Binding WelcomeMessage}"
            FontSize="{DynamicResource AppSubtitleFontSize}"
            HorizontalTextAlignment="Center"
            TextColor="{DynamicResource AppMutedTextColor}" />

        <Border
            Style="{StaticResource CardFrameStyle}"
            Padding="20"
            StrokeShape="RoundRectangle 24">

            <VerticalStackLayout Spacing="14">

                <Label
                    Text="Authentication settings"
                    Style="{StaticResource SectionTitleStyle}"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="{Binding BiometricEnabled, StringFormat='Biometric enabled: {0}'}"
                    FontSize="{DynamicResource AppBodyFontSize}"
                    HorizontalTextAlignment="Center"
                    TextColor="{DynamicResource AppMutedTextColor}" />

                <Button
                    Text="Enable biometric login"
                    Command="{Binding EnableBiometricCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" />

                <Button
                    Text="Disable biometric login"
                    Command="{Binding DisableBiometricCommand}"
                    Style="{StaticResource SecondaryButtonStyle}" />

                <Button
                    Text="Logout"
                    Command="{Binding LogoutCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{DynamicResource AppDangerColor}" />

            </VerticalStackLayout>
        </Border>

    </VerticalStackLayout>
</ContentPage>
