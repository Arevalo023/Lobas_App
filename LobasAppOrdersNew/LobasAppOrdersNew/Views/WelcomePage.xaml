<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LobasAppOrdersNew.Views.WelcomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:LobasAppOrdersNew.ViewModels"
    x:DataType="viewModels:WelcomeViewModel"
    Title="Inicio"
    BackgroundColor="{DynamicResource AppBackgroundColor}">

    <RefreshView
        Command="{Binding LoadDashboardCommand}"
        IsRefreshing="{Binding IsRefreshing}">

        <ScrollView>
            <VerticalStackLayout
                Padding="{OnIdiom Phone='16,18', Tablet='24', Desktop='28'}"
                Spacing="{OnIdiom Phone=16, Tablet=20, Desktop=22}">

                <!-- Header -->
                <Border
                    Style="{StaticResource CardFrameStyle}"
                    MaximumWidthRequest="900"
                    HorizontalOptions="Center"
                    Padding="{OnIdiom Phone='18', Tablet='22', Desktop='24'}">

                    <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="{OnIdiom Phone=12, Tablet=20, Desktop=24}">

                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="{OnIdiom Phone=8, Tablet=10, Desktop=10}"
                            VerticalOptions="Center">

                            <Label
                                Text="Bienvenida a Lobas Orders"
                                Style="{StaticResource PageTitleStyle}"
                                FontSize="{OnIdiom Phone=24, Tablet={DynamicResource AppTitleFontSize}, Desktop={DynamicResource AppTitleFontSize}}"
                                LineBreakMode="WordWrap" />

                            <Label
                                Text="Administra clientes, productos y pedidos desde un solo lugar."
                                Style="{StaticResource PageSubtitleStyle}"
                                LineBreakMode="WordWrap" />

                            <Label
                                Text="Resumen general de tu operaci&#xF3;n"
                                FontSize="{DynamicResource AppBodyFontSize}"
                                TextColor="{DynamicResource AppMutedTextColor}"
                                LineBreakMode="WordWrap" />

                        </VerticalStackLayout>

                        <Image
                            Grid.Column="1"
                            Source="splash.png"
                            WidthRequest="{OnIdiom Phone=82, Tablet=105, Desktop=112}"
                            HeightRequest="{OnIdiom Phone=82, Tablet=105, Desktop=112}"
                            Aspect="AspectFit"
                            HorizontalOptions="End"
                            VerticalOptions="Center" />

                    </Grid>
                </Border>

                <!-- Stats -->
                <FlexLayout
                    MaximumWidthRequest="900"
                    HorizontalOptions="Center"
                    Direction="Row"
                    Wrap="Wrap"
                    JustifyContent="SpaceBetween"
                    AlignItems="Stretch">

                    <Border
                        Style="{StaticResource CardFrameStyle}"
                        Margin="0,0,0,12"
                        FlexLayout.Basis="{OnIdiom Phone='100%', Tablet='31%', Desktop='31%'}">

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border
                                WidthRequest="44"
                                HeightRequest="44"
                                BackgroundColor="{DynamicResource AppBackgroundColor}"
                                Stroke="{DynamicResource AppBorderColor}"
                                StrokeShape="RoundRectangle 22"
                                VerticalOptions="Start">

                                <Image
                                    Source="{DynamicResource ProductsIconSource}"
                                    WidthRequest="24"
                                    HeightRequest="24"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label
                                    Text="Productos"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource AppSecondaryColor}" />

                                <Label
                                    Text="{Binding ProductsCountText}"
                                    FontSize="{OnIdiom Phone=32, Tablet=36, Desktop=38}"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource AppPrimaryColor}" />

                                <Label
                                    Text="Art&#xED;culos activos en cat&#xE1;logo"
                                    FontSize="13"
                                    TextColor="{DynamicResource AppMutedTextColor}"
                                    LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border
                        Style="{StaticResource CardFrameStyle}"
                        Margin="0,0,0,12"
                        FlexLayout.Basis="{OnIdiom Phone='100%', Tablet='31%', Desktop='31%'}">

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border
                                WidthRequest="44"
                                HeightRequest="44"
                                BackgroundColor="{DynamicResource AppBackgroundColor}"
                                Stroke="{DynamicResource AppBorderColor}"
                                StrokeShape="RoundRectangle 22"
                                VerticalOptions="Start">

                                <Image
                                    Source="{DynamicResource CustomersIconSource}"
                                    WidthRequest="24"
                                    HeightRequest="24"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label
                                    Text="Clientes"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource AppSecondaryColor}" />

                                <Label
                                    Text="{Binding CustomersCountText}"
                                    FontSize="{OnIdiom Phone=32, Tablet=36, Desktop=38}"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource AppPrimaryColor}" />

                                <Label
                                    Text="Contactos registrados"
                                    FontSize="13"
                                    TextColor="{DynamicResource AppMutedTextColor}"
                                    LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border
                        Style="{StaticResource CardFrameStyle}"
                        Margin="0,0,0,12"
                        FlexLayout.Basis="{OnIdiom Phone='100%', Tablet='31%', Desktop='31%'}">

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border
                                WidthRequest="44"
                                HeightRequest="44"
                                BackgroundColor="{DynamicResource AppBackgroundColor}"
                                Stroke="{DynamicResource AppBorderColor}"
                                StrokeShape="RoundRectangle 22"
                                VerticalOptions="Start">

                                <Image
                                    Source="{DynamicResource OrdersIconSource}"
                                    WidthRequest="24"
                                    HeightRequest="24"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label
                                    Text="Pedidos"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource AppSecondaryColor}" />

                                <Label
                                    Text="{Binding OrdersCountText}"
                                    FontSize="{OnIdiom Phone=32, Tablet=36, Desktop=38}"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource AppPrimaryColor}" />

                                <Label
                                    Text="Pedidos creados"
                                    FontSize="13"
                                    TextColor="{DynamicResource AppMutedTextColor}"
                                    LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                </FlexLayout>

                <!-- Quick actions -->
                <Border
                    Style="{StaticResource CardFrameStyle}"
                    MaximumWidthRequest="900"
                    HorizontalOptions="Center">

                    <VerticalStackLayout Spacing="16">

                        <VerticalStackLayout Spacing="4">
                            <Label
                                Text="Accesos r&#xE1;pidos"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource AppTextColor}" />

                            <Label
                                Text="Entra directo a los m&#xF3;dulos principales."
                                FontSize="{DynamicResource AppBodyFontSize}"
                                TextColor="{DynamicResource AppMutedTextColor}"
                                LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                        <FlexLayout
                            Direction="Row"
                            Wrap="Wrap"
                            JustifyContent="SpaceBetween">

                            <Button
                                Text="Productos"
                                Command="{Binding GoToProductsCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,0,10"
                                FlexLayout.Basis="{OnIdiom Phone='100%', Tablet='31%', Desktop='31%'}" />

                            <Button
                                Text="Clientes"
                                Command="{Binding GoToCustomersCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,0,10"
                                FlexLayout.Basis="{OnIdiom Phone='100%', Tablet='31%', Desktop='31%'}" />

                            <Button
                                Text="Pedidos"
                                Command="{Binding GoToOrdersCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,0,10"
                                FlexLayout.Basis="{OnIdiom Phone='100%', Tablet='31%', Desktop='31%'}" />

                        </FlexLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- Info -->
                <Border
                    Style="{StaticResource CardFrameStyle}"
                    MaximumWidthRequest="900"
                    HorizontalOptions="Center"
                    Shadow="{x:Null}">

                    <VerticalStackLayout Spacing="10">

                        <Label
                            Text="Resumen del sistema"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource AppTextColor}" />

                        <Label
                            Text="La aplicaci&#xF3;n usa una interfaz .NET MAUI conectada a una API REST con ASP.NET Core. Incluye operaciones CRUD, b&#xFA;squeda, gestos de deslizamiento, inicio de sesi&#xF3;n con Google, acceso biom&#xE9;trico y cambio din&#xE1;mico de tema."
                            FontSize="{DynamicResource AppBodyFontSize}"
                            TextColor="{DynamicResource AppMutedTextColor}"
                            LineBreakMode="WordWrap" />

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
