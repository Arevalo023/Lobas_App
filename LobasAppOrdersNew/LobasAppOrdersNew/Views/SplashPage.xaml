<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LobasAppOrdersNew.Views.SplashPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#FCE7F3"
    NavigationPage.HasNavigationBar="False">

    <Grid Padding="30">

        <VerticalStackLayout
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Spacing="18">

            <Frame
                WidthRequest="180"
                HeightRequest="180"
                CornerRadius="90"
                BackgroundColor="#FFFFFF"
                BorderColor="#F9A8D4"
                HasShadow="True"
                Padding="18"
                HorizontalOptions="Center">

                <Image
                    Source="splash.png"
                    WidthRequest="140"
                    HeightRequest="140"
                    Aspect="AspectFit"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />

            </Frame>

            <Label
                Text="Lobas Orders"
                TextColor="#831843"
                FontSize="32"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center" />

            <Label
                Text="Order Management App"
                TextColor="#BE185D"
                FontSize="15"
                HorizontalTextAlignment="Center" />

            <ActivityIndicator
                IsRunning="True"
                Color="#DB2777"
                WidthRequest="40"
                HeightRequest="40"
                Margin="0,22,0,0"
                HorizontalOptions="Center" />

        </VerticalStackLayout>

    </Grid>
</ContentPage>