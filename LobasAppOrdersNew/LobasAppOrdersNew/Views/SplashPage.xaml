<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LobasAppOrdersNew.Views.SplashPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{DynamicResource AppBackgroundColor}"
    NavigationPage.HasNavigationBar="False">

    <Grid Padding="30">

        <VerticalStackLayout
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Spacing="18">

            <Frame
                WidthRequest="180"
                HeightRequest="180"
                CornerRadius="90"
                BackgroundColor="{DynamicResource AppCardColor}"
                BorderColor="{DynamicResource AppBorderColor}"
                HasShadow="True"
                Padding="18"
                HorizontalOptions="Center">

                <Image
                    Source="splash.png"
                    WidthRequest="140"
                    HeightRequest="140"
                    Aspect="AspectFit"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />

            </Frame>

            <Label
                Text="Lobas Orders"
                TextColor="{DynamicResource AppTextColor}"
                FontSize="{DynamicResource AppTitleFontSize}"
                FontAttributes="Bold"
                FontFamily="{DynamicResource AppTitleFontFamily}"
                HorizontalTextAlignment="Center" />

            <Label
                Text="Order Management App"
                TextColor="{DynamicResource AppSecondaryColor}"
                FontSize="{DynamicResource AppBodyFontSize}"
                FontFamily="{DynamicResource AppBodyFontFamily}"
                HorizontalTextAlignment="Center" />

            <ActivityIndicator
                IsRunning="True"
                Color="{DynamicResource AppPrimaryColor}"
                WidthRequest="40"
                HeightRequest="40"
                Margin="0,22,0,0"
                HorizontalOptions="Center" />

        </VerticalStackLayout>

    </Grid>
</ContentPage>
