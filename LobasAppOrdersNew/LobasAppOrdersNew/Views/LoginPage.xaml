<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LobasAppOrdersNew.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:LobasAppOrdersNew.ViewModels"
    x:DataType="viewModels:LoginViewModel"
    Title="Login"
    BackgroundColor="{DynamicResource AppBackgroundColor}">

    <ScrollView>
        <Grid
            Padding="{OnIdiom Phone='16,18', Tablet='28', Desktop='32'}"
            RowDefinitions="Auto">

            <Border
                Style="{StaticResource CardFrameStyle}"
                MaximumWidthRequest="460"
                HorizontalOptions="Center"
                VerticalOptions="Start"
                Margin="0,12"
                Padding="{OnIdiom Phone='18', Tablet='24', Desktop='26'}">

                <VerticalStackLayout
                    Spacing="{OnIdiom Phone=12, Tablet=16, Desktop=16}">
                        <Image
                            Source="splash.png"
                            HeightRequest="{OnIdiom Phone=86, Tablet=112, Desktop=118}"
                            WidthRequest="{OnIdiom Phone=86, Tablet=112, Desktop=118}"
                            HorizontalOptions="Center"
                            Aspect="AspectFit" />

                        <Label
                            Text="Welcome back"
                            Style="{StaticResource PageTitleStyle}"
                            FontSize="{OnIdiom Phone=24, Tablet={DynamicResource AppTitleFontSize}, Desktop={DynamicResource AppTitleFontSize}}"
                            HorizontalTextAlignment="Center"
                            Margin="0,2,0,0" />

                        <Label
                            Text="Access your account and continue managing your orders."
                            Style="{StaticResource PageSubtitleStyle}"
                            HorizontalTextAlignment="Center"
                            LineBreakMode="WordWrap"
                            Margin="0,0,0,4" />

                        <VerticalStackLayout Spacing="6">
                            <Label
                                Text="Email"
                                TextColor="{DynamicResource AppTextColor}"
                                FontAttributes="Bold" />

                            <Entry
                                Placeholder="Enter your email"
                                Text="{Binding Email}"
                                Keyboard="Email"
                                Style="{StaticResource InputEntryStyle}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label
                                Text="Password"
                                TextColor="{DynamicResource AppTextColor}"
                                FontAttributes="Bold" />

                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8">

                                <Entry
                                    Grid.Column="0"
                                    Placeholder="Enter your password"
                                    Text="{Binding Password}"
                                    IsPassword="{Binding IsPasswordHidden}"
                                    Style="{StaticResource InputEntryStyle}" />

                                <Button
                                    Grid.Column="1"
                                    Text="{Binding PasswordToggleText}"
                                    Command="{Binding TogglePasswordVisibilityCommand}"
                                    BackgroundColor="{DynamicResource AppBorderColor}"
                                    TextColor="{DynamicResource AppTextColor}"
                                    WidthRequest="64"
                                    HeightRequest="50"
                                    CornerRadius="14"
                                    Padding="8,0"
                                    FontSize="{DynamicResource AppCaptionFontSize}" />
                            </Grid>
                        </VerticalStackLayout>

                        <Grid HeightRequest="52">
                            <Button
                                Text="Login"
                                Command="{Binding LoginCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HeightRequest="52" />

                            <ActivityIndicator
                                IsRunning="{Binding IsLoginLoading}"
                                IsVisible="{Binding IsLoginLoading}"
                                Color="{DynamicResource AppButtonTextColor}"
                                WidthRequest="24"
                                HeightRequest="24"
                                HorizontalOptions="End"
                                VerticalOptions="Center"
                                Margin="0,0,18,0" />
                        </Grid>

                        <Grid HeightRequest="50">
                            <Button
                                Text="Sign in with Google"
                                Command="{Binding GoogleLoginCommand}"
                                BackgroundColor="{DynamicResource AppInputBackgroundColor}"
                                TextColor="{DynamicResource AppTextColor}"
                                BorderColor="{DynamicResource AppBorderColor}"
                                BorderWidth="1"
                                CornerRadius="18"
                                HeightRequest="50"
                                FontAttributes="Bold" />

                            <ActivityIndicator
                                IsRunning="{Binding IsGoogleLoading}"
                                IsVisible="{Binding IsGoogleLoading}"
                                Color="{DynamicResource AppPrimaryColor}"
                                WidthRequest="24"
                                HeightRequest="24"
                                HorizontalOptions="End"
                                VerticalOptions="Center"
                                Margin="0,0,18,0" />
                        </Grid>

                        <Button
                            Text="Biometric Login"
                            Command="{Binding BiometricLoginCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsVisible="{Binding IsBiometricButtonVisible}" />

                        <HorizontalStackLayout
                            HorizontalOptions="Center"
                            Spacing="4"
                            Margin="0,2,0,0">

                            <Label
                                Text="Don't have an account?"
                                TextColor="{DynamicResource AppMutedTextColor}"
                                VerticalOptions="Center" />

                            <Button
                                Text="Register"
                                Command="{Binding GoToRegisterCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="6,0"
                                MinimumWidthRequest="0" />
                        </HorizontalStackLayout>

                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
