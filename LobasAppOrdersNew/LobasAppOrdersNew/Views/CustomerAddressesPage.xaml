<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LobasAppOrdersNew.Views.CustomerAddressesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:LobasAppOrdersNew.Models"
    xmlns:viewModels="clr-namespace:LobasAppOrdersNew.ViewModels"
    x:DataType="viewModels:CustomerAddressesViewModel"
    Title="Direcciones"
    BackgroundColor="{DynamicResource AppBackgroundColor}">

    <ScrollView>
        <VerticalStackLayout
            Padding="{OnIdiom Phone='16,18', Tablet='24', Desktop='28'}"
            Spacing="18">

            <VerticalStackLayout Spacing="4">
                <Label
                    Text="Direcciones"
                    Style="{StaticResource PageTitleStyle}" />

                <Label
                    Text="{Binding PageSubtitle}"
                    Style="{StaticResource PageSubtitleStyle}" />
            </VerticalStackLayout>

            <Border
                Style="{StaticResource CardFrameStyle}"
                MaximumWidthRequest="760"
                HorizontalOptions="Center">

                <VerticalStackLayout Spacing="14">
                    <Label
                        Text="{Binding FormTitle}"
                        Style="{StaticResource SectionTitleStyle}" />

                    <VerticalStackLayout Spacing="6">
                        <Label
                            Text="Calle y n&#xFA;mero"
                            TextColor="{DynamicResource AppTextColor}"
                            FontAttributes="Bold" />

                        <Entry
                            Placeholder="Ej. Av. Reforma 123"
                            Text="{Binding Street}"
                            Style="{StaticResource InputEntryStyle}" />
                    </VerticalStackLayout>

                    <Grid
                        ColumnDefinitions="{OnIdiom Phone='*', Tablet='*,*', Desktop='*,*'}"
                        RowDefinitions="{OnIdiom Phone='Auto,Auto', Tablet='Auto', Desktop='Auto'}"
                        ColumnSpacing="12"
                        RowSpacing="12">

                        <VerticalStackLayout Spacing="6">
                            <Label
                                Text="Ciudad"
                                TextColor="{DynamicResource AppTextColor}"
                                FontAttributes="Bold" />

                            <Entry
                                Placeholder="Ciudad"
                                Text="{Binding City}"
                                Style="{StaticResource InputEntryStyle}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout
                            Grid.Column="{OnIdiom Phone=0, Tablet=1, Desktop=1}"
                            Grid.Row="{OnIdiom Phone=1, Tablet=0, Desktop=0}"
                            Spacing="6">

                            <Label
                                Text="Estado"
                                TextColor="{DynamicResource AppTextColor}"
                                FontAttributes="Bold" />

                            <Entry
                                Placeholder="Estado"
                                Text="{Binding State}"
                                Style="{StaticResource InputEntryStyle}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid
                        ColumnDefinitions="{OnIdiom Phone='*', Tablet='*,Auto', Desktop='*,Auto'}"
                        RowDefinitions="{OnIdiom Phone='Auto,Auto', Tablet='Auto', Desktop='Auto'}"
                        ColumnSpacing="12"
                        RowSpacing="12">

                        <VerticalStackLayout Spacing="6">
                            <Label
                                Text="C&#xF3;digo postal"
                                TextColor="{DynamicResource AppTextColor}"
                                FontAttributes="Bold" />

                            <Entry
                                Placeholder="Ej. 64000"
                                Keyboard="Numeric"
                                MaxLength="10"
                                Text="{Binding ZipCode}"
                                Style="{StaticResource InputEntryStyle}" />
                        </VerticalStackLayout>

                        <HorizontalStackLayout
                            Grid.Column="{OnIdiom Phone=0, Tablet=1, Desktop=1}"
                            Grid.Row="{OnIdiom Phone=1, Tablet=0, Desktop=0}"
                            Spacing="10"
                            VerticalOptions="End"
                            HeightRequest="50">

                            <CheckBox
                                IsChecked="{Binding IsMain}"
                                VerticalOptions="Center" />

                            <Label
                                Text="Direcci&#xF3;n principal"
                                TextColor="{DynamicResource AppTextColor}"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Grid>

                    <Grid HeightRequest="52">
                        <Button
                            Text="{Binding SaveButtonText}"
                            Command="{Binding SaveAddressCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HeightRequest="52" />

                        <ActivityIndicator
                            IsRunning="{Binding IsSaving}"
                            IsVisible="{Binding IsSaving}"
                            Color="{DynamicResource AppButtonTextColor}"
                            WidthRequest="24"
                            HeightRequest="24"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            Margin="0,0,18,0" />
                    </Grid>

                    <Button
                        Text="{Binding CancelButtonText}"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" />
                </VerticalStackLayout>
            </Border>

            <Border
                Style="{StaticResource CardFrameStyle}"
                MaximumWidthRequest="760"
                HorizontalOptions="Center">

                <VerticalStackLayout Spacing="14">
                    <Label
                        Text="Direcciones registradas"
                        Style="{StaticResource SectionTitleStyle}" />

                    <CollectionView
                        ItemsSource="{Binding Addresses}"
                        SelectionMode="None">

                        <CollectionView.EmptyView>
                            <Label
                                Text="Este cliente a&#xFA;n no tiene direcciones registradas."
                                TextColor="{DynamicResource AppMutedTextColor}"
                                HorizontalTextAlignment="Center"
                                Margin="0,16" />
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:AddressModel">
                                <SwipeView Margin="0,0,0,10">
                                    <SwipeView.LeftItems>
                                        <SwipeItems Mode="Reveal">
                                            <SwipeItem
                                                Text="Editar"
                                                BackgroundColor="{DynamicResource AppEditColor}"
                                                Invoked="OnEditAddressInvoked" />
                                        </SwipeItems>
                                    </SwipeView.LeftItems>

                                    <SwipeView.RightItems>
                                        <SwipeItems Mode="Reveal">
                                            <SwipeItem
                                                Text="Eliminar"
                                                BackgroundColor="{DynamicResource AppDangerColor}"
                                                Invoked="OnDeleteAddressInvoked" />
                                        </SwipeItems>
                                    </SwipeView.RightItems>

                                    <Border
                                        Style="{StaticResource CardFrameStyle}"
                                        Shadow="{x:Null}">

                                        <Grid
                                            ColumnDefinitions="*,Auto"
                                            RowDefinitions="Auto,Auto">

                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Text="{Binding FullAddressText}"
                                                FontAttributes="Bold"
                                                FontSize="15"
                                                TextColor="{DynamicResource AppTextColor}" />

                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Text="{Binding MainAddressText}"
                                                FontAttributes="Bold"
                                                FontSize="12"
                                                TextColor="{DynamicResource AppPrimaryColor}" />

                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Text="{Binding CustomerName}"
                                                FontSize="13"
                                                TextColor="{DynamicResource AppMutedTextColor}"
                                                Margin="0,6,0,0" />
                                        </Grid>
                                    </Border>
                                </SwipeView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
