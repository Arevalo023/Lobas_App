<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LobasAppOrdersNew.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Perfil"
    BackgroundColor="{DynamicResource AppBackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="22">

            <VerticalStackLayout Spacing="4">
                <Label
                    Text="Perfil"
                    Style="{StaticResource PageTitleStyle}" />

                <Label
                    Text="Consulta tu usuario y administra preferencias de acceso."
                    Style="{StaticResource PageSubtitleStyle}" />
            </VerticalStackLayout>

            <Frame Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="Usuario actual"
                        Style="{StaticResource SectionTitleStyle}" />

                    <Label
                        Text="Nombre"
                        FontSize="{DynamicResource AppCaptionFontSize}"
                        TextColor="{DynamicResource AppMutedTextColor}" />

                    <Entry
                        Text="{Binding Name}"
                        Placeholder="Nombre"
                        Style="{StaticResource InputEntryStyle}" />

                    <Label
                        Text="{Binding LastNameChangedText}"
                        FontSize="{DynamicResource AppCaptionFontSize}"
                        TextColor="{DynamicResource AppMutedTextColor}" />

                    <Button
                        Text="Guardar nombre"
                        Command="{Binding SaveNameCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" />

                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="Datos de la cuenta"
                        Style="{StaticResource SectionTitleStyle}" />

                    <Label
                        Text="{Binding Email, StringFormat='Correo: {0}'}"
                        FontSize="{DynamicResource AppBodyFontSize}"
                        TextColor="{DynamicResource AppTextColor}" />

                    <Label
                        Text="{Binding AuthProvider, StringFormat='Acceso: {0}'}"
                        FontSize="{DynamicResource AppBodyFontSize}"
                        TextColor="{DynamicResource AppTextColor}" />

                    <Label
                        Text="{Binding BiometricStatus, StringFormat='Biometria: {0}'}"
                        FontSize="{DynamicResource AppBodyFontSize}"
                        TextColor="{DynamicResource AppTextColor}" />

                    <Button
                        Text="Deshabilitar biometria"
                        Command="{Binding DisableBiometricCommand}"
                        IsEnabled="{Binding BiometricEnabled}"
                        Style="{StaticResource PrimaryButtonStyle}" />

                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
